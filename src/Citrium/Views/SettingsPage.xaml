<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Citrium.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <LinearGradientBrush x:Key="UpdateBadgeSuccess" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#54B054" Offset="0" />
            <GradientStop Color="#107C10" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UpdateBadgeInfo" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2AA0F2" Offset="0" />
            <GradientStop Color="#0F6CBD" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="UpdateBadgeCaution" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8A317" Offset="0" />
            <GradientStop Color="#B86E00" Offset="1" />
        </LinearGradientBrush>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource PageTitleTextBlockStyle}" Margin="{StaticResource PageHeaderMargin}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PageContentPadding}" Spacing="{StaticResource SettingsCardSpacing}">
                <Grid Margin="12,0,0,12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="68" Height="64">
                        <Viewbox Width="60" Height="60" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Canvas Width="48" Height="48">
                                <Path Data="M6.6,22 A17.5,17.5 0 0 1 39,15 M39,6 V15 H30" StrokeThickness="4.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Stroke>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                            <GradientStop Color="#0F6CBD" Offset="0" />
                                            <GradientStop Color="#2AA0F2" Offset="1" />
                                        </LinearGradientBrush>
                                    </Path.Stroke>
                                </Path>
                                <Path Data="M38.9,33 A17.5,17.5 0 0 1 9,33 M9,42 V33 H18" StrokeThickness="4.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Stroke>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                            <GradientStop Color="#2AA0F2" Offset="0" />
                                            <GradientStop Color="#0F6CBD" Offset="1" />
                                        </LinearGradientBrush>
                                    </Path.Stroke>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <Grid x:Name="UpdateBadge" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Ellipse x:Name="UpdateBadgeFill" />
                            <FontIcon x:Name="UpdateBadgeIcon" FontSize="15" FontWeight="Bold" Foreground="White" />
                        </Grid>
                        <ProgressRing x:Name="UpdateRing" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="UpdateDetail" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Check for updates" VerticalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}" Click="CheckNow_Click" />
                </Grid>
                <Grid x:Name="UpdateAvailableBar" Visibility="Collapsed" MinHeight="48" Padding="16,4,4,4" ColumnSpacing="12"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xF167;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="UpdateAvailableText" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                    <HyperlinkButton x:Name="UpdateActionLink" Grid.Column="2" VerticalAlignment="Center" Click="UpdateAction_Click" />
                    <Button Grid.Column="3" Style="{StaticResource ViewerToolButtonStyle}" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Click="DismissUpdate_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <tk:SettingsCard Header="Install updates automatically">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE823;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="UpdatesToggle" Toggled="UpdatesToggle_Toggled" />
                </tk:SettingsCard>

                <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <tk:SettingsCard Header="App theme" Description="Select which app theme to display.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem Content="Use system setting" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Window material" Description="The translucent effect behind the window.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="BackdropBox" MinWidth="200" SelectionChanged="BackdropBox_SelectionChanged">
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                    </ComboBox>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Show organization logo" Description="Display your organization's logo, from its Citrix store, in the navigation pane.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B9;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="LogoToggle" Toggled="LogoToggle_Toggled" />
                </tk:SettingsCard>

                <TextBlock Text="Startup and closing" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <tk:SettingsCard Header="Refresh accounts on startup" Description="Use your saved sign-in to load apps and desktops when Citrium opens.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72C;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="RefreshToggle" Toggled="RefreshToggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Minimize to the notification area when closed"
                                 Description="Closing the window keeps Citrium running in the system tray. Right-click the tray icon to quit.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE75B;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="TrayToggle" Toggled="TrayToggle_Toggled" />
                </tk:SettingsCard>

                <tk:SettingsCard Header="Start with Windows" Description="Citrium starts in the notification area when you sign in.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="StartupToggle" Toggled="StartupToggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Open when Citrium starts" Description="Have an app or desktop ready and waiting.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE768;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="AutoOpenBox" MinWidth="200" MaxWidth="320" SelectionChanged="AutoOpenBox_SelectionChanged" />
                </tk:SettingsCard>

                <TextBlock Text="Connections" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <tk:SettingsCard x:Name="ViewerCard" Header="Open desktops in">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE737;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="InstallWorkspaceButton" Content="Install Citrix Workspace" Visibility="Collapsed"
                                Click="InstallWorkspace_Click" />
                        <ComboBox x:Name="ViewerBox" MinWidth="200" SelectionChanged="ViewerBox_SelectionChanged">
                            <ComboBoxItem Content="Citrium viewer" Tag="Citrium" />
                            <ComboBoxItem Content="Citrix Desktop Viewer" Tag="Citrix" />
                        </ComboBox>
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Disconnect desktops when Windows locks"
                                 Description="Your desktops keep running if your organization allows it, and Citrium offers to reconnect when you're back.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72E;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="LockToggle" Toggled="LockToggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsExpander x:Name="EngineCard" Header="Citrix HDX engine"
                                     Description="Displays your apps and desktops. Installed with Citrix Workspace app.">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></tk:SettingsExpander.HeaderIcon>
                    <TextBlock x:Name="EngineStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard x:Name="EnginePathCard" Header="Location">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Browse" Click="Browse_Click" />
                                <Button Content="Detect automatically" Click="AutoDetect_Click" />
                            </StackPanel>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Keep launch files" Description="For troubleshooting only. Launch files contain single-use sign-in tickets.">
                            <ToggleSwitch x:Name="KeepIcaToggle" Toggled="KeepIcaToggle_Toggled" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <TextBlock Text="Troubleshooting" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <tk:SettingsCard Header="Clear icon cache" Description="Icons are downloaded again the next time you refresh.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;" /></tk:SettingsCard.HeaderIcon>
                    <Button Content="Clear" Click="ClearIcons_Click" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Open data folder" Description="Settings, logs and cached icons." IsClickEnabled="True" Click="OpenData_Click">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE838;" /></tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>

                <TextBlock Text="About" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <tk:SettingsCard x:Name="AboutCard" Header="Citrium">
                    <tk:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Citrium.png" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
