<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Citrium.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource PageTitleTextBlockStyle}" Margin="{StaticResource PageHeaderMargin}" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PageContentPadding}" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="1,0,0,6" />
                <tk:SettingsCard Header="App theme" Description="Select which app theme to display.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem Content="Use system setting" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Window material" Description="The translucent effect behind the window.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="BackdropBox" MinWidth="200" SelectionChanged="BackdropBox_SelectionChanged">
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                    </ComboBox>
                </tk:SettingsCard>

                <tk:SettingsCard Header="Show organization logo" Description="Display your organization's logo, from its Citrix store, in the navigation pane.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B9;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="LogoToggle" Toggled="LogoToggle_Toggled" />
                </tk:SettingsCard>

                <TextBlock Text="Startup and closing" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <tk:SettingsCard Header="Refresh accounts on startup" Description="Use your saved sign-in to load apps and desktops when Citrium opens.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72C;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="RefreshToggle" Toggled="RefreshToggle_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Minimize to the notification area when closed"
                                 Description="Closing the window keeps Citrium running in the system tray. Right-click the tray icon to quit.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE75B;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="TrayToggle" Toggled="TrayToggle_Toggled" />
                </tk:SettingsCard>

                <TextBlock Text="Connections" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <tk:SettingsCard x:Name="ViewerCard" Header="Open desktops in">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE737;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="InstallWorkspaceButton" Content="Install Citrix Workspace" Visibility="Collapsed"
                                Click="InstallWorkspace_Click" />
                        <ComboBox x:Name="ViewerBox" MinWidth="200" SelectionChanged="ViewerBox_SelectionChanged">
                            <ComboBoxItem Content="Citrium viewer" Tag="Citrium" />
                            <ComboBoxItem Content="Citrix Desktop Viewer" Tag="Citrix" />
                        </ComboBox>
                    </StackPanel>
                </tk:SettingsCard>
                <tk:SettingsExpander x:Name="EngineCard" Header="Citrix HDX engine"
                                     Description="Displays your apps and desktops. Installed with Citrix Workspace app.">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></tk:SettingsExpander.HeaderIcon>
                    <TextBlock x:Name="EngineStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard x:Name="EnginePathCard" Header="Location">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Browse" Click="Browse_Click" />
                                <Button Content="Detect automatically" Click="AutoDetect_Click" />
                            </StackPanel>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Keep launch files" Description="For troubleshooting only. Launch files contain single-use sign-in tickets.">
                            <ToggleSwitch x:Name="KeepIcaToggle" Toggled="KeepIcaToggle_Toggled" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <TextBlock Text="Troubleshooting" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <tk:SettingsCard Header="Clear icon cache" Description="Icons are downloaded again the next time you refresh.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;" /></tk:SettingsCard.HeaderIcon>
                    <Button Content="Clear" Click="ClearIcons_Click" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Open data folder" Description="Settings, logs and cached icons." IsClickEnabled="True" Click="OpenData_Click">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE838;" /></tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>

                <TextBlock Text="About" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <tk:SettingsCard x:Name="AboutCard" Header="Citrium">
                    <tk:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Citrium.png" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
