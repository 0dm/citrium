<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Citrium.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Sessions" Style="{StaticResource PageTitleTextBlockStyle}" Margin="{StaticResource PageHeaderMargin}" />

        <ScrollViewer x:Name="Scroller" Grid.Row="1">
            <StackPanel Padding="{StaticResource PageContentPadding}" Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel x:Name="List" Spacing="{StaticResource SettingsCardSpacing}" />

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Spacing="8" Margin="0,96,0,0" MaxWidth="400">
                    <FontIcon Glyph="&#xE8A1;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="All quiet" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Apps and desktops you open appear here, including ones started from other Citrix launchers."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
