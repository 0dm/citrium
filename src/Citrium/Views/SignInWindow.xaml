<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Citrium.Views.SignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sign in">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Sign in">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Citrium.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <Border x:Name="AddressPill" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="10,4" CornerRadius="{StaticResource ControlCornerRadius}"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}" MaxWidth="420">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="LockIcon" Glyph="&#xE72E;" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="HostText" VerticalAlignment="Center" TextWrapping="NoWrap" MaxLines="1"
                                   TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button x:Name="ReloadButton" Click="Reload_Click" ToolTipService.ToolTip="Reload (F5)"
                        AutomationProperties.Name="Reload" Width="40" Height="32" Padding="0" Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid Grid.Row="1">
            <WebView2 x:Name="Web" />
            <ProgressBar x:Name="Loading" IsIndeterminate="True" VerticalAlignment="Top" />
            <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="32" CornerRadius="{StaticResource OverlayCornerRadius}">
                <ProgressRing IsActive="True" />
                <TextBlock Text="Signed in. Loading your apps…" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
