<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Citrium.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Accounts" Style="{StaticResource PageTitleTextBlockStyle}" Margin="{StaticResource PageHeaderMargin}" />

        <!-- No MaxWidth here: a MaxWidth'd, stretched panel inside a ScrollViewer gets mis-arranged and clips the cards' right edge. -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource PageContentPadding}" Spacing="{StaticResource SettingsCardSpacing}">
                <tk:SettingsCard Header="Add a Citrix account" Description="Connect to your organization's StoreFront store or Citrix Gateway.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8FA;" /></tk:SettingsCard.HeaderIcon>
                    <Button Content="Add account" Style="{StaticResource AccentButtonStyle}" Click="Add_Click" />
                </tk:SettingsCard>

                <TextBlock x:Name="ListHeader" Text="Your accounts" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <StackPanel x:Name="List" Spacing="{StaticResource SettingsCardSpacing}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
