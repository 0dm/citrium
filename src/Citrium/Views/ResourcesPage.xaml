<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Citrium.Views.ResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Citrium.Models">

    <Page.Resources>
        <DataTemplate x:Key="TileTemplate" x:DataType="models:StoreResource">
            <Grid Width="112" Height="104" Padding="6,14,6,6" RowSpacing="8"
                  AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open" Click="Open_Click" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="{x:Bind FavoriteLabel, Mode=OneWay}" Click="Favorite_Click" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Add desktop shortcut" Click="Shortcut_Click" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Properties" Click="Details_Click" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                    <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                    <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" Visibility="{x:Bind NoIcon, Mode=OneWay}" />
                    <ProgressRing IsActive="{x:Bind IsLaunching, Mode=OneWay}" Width="48" Height="48" Margin="-4" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{x:Bind Name}" TextAlignment="Center" TextWrapping="WrapWholeWords" MaxLines="2"
                           TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </DataTemplate>

        <!-- Home's tiles. Sizes come from TileMosaic, so everything in here stretches and shrinks with it. -->
        <DataTemplate x:Key="MosaicTileTemplate" x:DataType="models:StoreResource">
            <Button Tag="{x:Bind}" Click="MosaicTile_Click" Padding="12,10,12,10" CornerRadius="8"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open" Click="Open_Click" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="{x:Bind FavoriteLabel, Mode=OneWay}" Click="Favorite_Click" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Add desktop shortcut" Click="Shortcut_Click" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Properties" Click="Details_Click" Tag="{x:Bind}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.ContextFlyout>

                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Viewbox MaxWidth="112" MaxHeight="112" Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="48" Height="48">
                            <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                            <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="36" Visibility="{x:Bind NoIcon, Mode=OneWay}" />
                            <ProgressRing IsActive="{x:Bind IsLaunching, Mode=OneWay}" Width="56" Height="56" Margin="-4" />
                        </Grid>
                    </Viewbox>
                    <TextBlock Grid.Row="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1"
                               Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="TileGrid" TargetType="GridView">
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="IsItemClickEnabled" Value="True" />
            <Setter Property="ItemTemplate" Value="{StaticResource TileTemplate}" />
            <Setter Property="Margin" Value="-4,0,-4,0" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Header" Style="{StaticResource PageTitleTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ComboBox x:Name="FolderFilter" Grid.Column="1" MinWidth="180" VerticalAlignment="Center" Visibility="Collapsed"
                      PlaceholderText="All categories" SelectionChanged="FolderFilter_SelectionChanged"
                      AutomationProperties.Name="Category" />
            <CommandBar Grid.Column="2" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False" VerticalAlignment="Center" Margin="0,-8"
                        OverflowButtonVisibility="Collapsed">
                <AppBarButton Label="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Refresh (F5)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1">
            <StackPanel Padding="{StaticResource PageContentPadding}">
                <InfoBar x:Name="SignInBar" Severity="Informational" IsClosable="False" IsOpen="False" Margin="0,0,0,8">
                    <InfoBar.ActionButton>
                        <Button Content="Sign in" Click="SignIn_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Border x:Name="MosaicHost" Visibility="Collapsed" />

                <TextBlock x:Name="Section1Header" Style="{StaticResource SectionHeaderTextBlockStyle}" Margin="1,0,0,6" />
                <GridView x:Name="Section1" Style="{StaticResource TileGrid}" ItemClick="Tile_ItemClick" />
                <TextBlock x:Name="Section2Header" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <GridView x:Name="Section2" Style="{StaticResource TileGrid}" ItemClick="Tile_ItemClick" />

                <TextBlock x:Name="Section3Header" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <GridView x:Name="Section3" Style="{StaticResource TileGrid}" ItemClick="Tile_ItemClick" />

                <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="8" Margin="0,96,0,0" MaxWidth="400">
                    <FontIcon x:Name="EmptyGlyph" Glyph="&#xE71D;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" />
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="EmptyAction" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Content="Add account" Click="AddAccount_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
