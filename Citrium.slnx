<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <BuildType Name="Demo" />
    <Platform Name="x64" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/src/">
    <Project Path="src/Citrium/Citrium.csproj">
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|ARM64" Project="ARM64" />
    </Project>
  </Folder>
  <Folder Name="/demo/">
    <Project Path="src/Citrium.DemoMachine/Citrium.DemoMachine.csproj">
      <BuildType Solution="Demo|*" Project="Release" />
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|ARM64" Project="ARM64" />
    </Project>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Citrium.Tests/Citrium.Tests.csproj">
      <BuildType Solution="Demo|*" Project="Debug" />
      <Platform Solution="*|x64" Project="Any CPU" />
      <Platform Solution="*|ARM64" Project="Any CPU" />
    </Project>
  </Folder>
</Solution>
